<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon foreground: the app's quality line in miniature.
     Dim / mid / bright segments = sharper and sharper picture, a red dot = a freeze,
     a thin vertical bar = the playhead, then the empty rest of the track.
     Adaptive icons are 108dp; launchers may crop to the middle 66dp, so it all sits there. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 480p and below -->
    <path android:fillColor="#5C5A55" android:pathData="M28,51h14v6h-14z" />
    <!-- 720p -->
    <path android:fillColor="#8A8780" android:pathData="M42,51h14v6h-14z" />
    <!-- 1080p+ -->
    <path android:fillColor="#F2F0EB" android:pathData="M56,51h14v6h-14z" />
    <!-- Not played yet -->
    <path android:fillColor="#2A2A28" android:pathData="M70,51h10v6h-10z" />
    <!-- A freeze -->
    <path android:fillColor="#E5674A" android:pathData="M44.5,54m-4.5,0a4.5,4.5 0,1 0,9 0a4.5,4.5 0,1 0,-9 0" />
    <!-- Playhead -->
    <path android:fillColor="#F2F0EB" android:pathData="M69,44h2v20h-2z" />
</vector>
