<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "leanback" = the Android TV user interface. required="false" means the app
         is built for TV but can still be installed on phones (handy for testing). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- TVs have no touchscreen. Without this line, Google Play would hide the app
         from TVs, because Android assumes every app needs touch by default. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Needed to stream the public test videos. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- android:banner = the 320x180 tile shown for the app on the TV home screen.
         (TV launchers use this wide banner instead of a square icon.) -->
    <!-- android:icon = the square icon used on phones and in system settings. -->
    <application
        android:name=".StreamTestApp"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamTest">

        <!-- sensorLandscape: the screens are designed for a landscape TV. TVs are always
             landscape anyway; this keeps a phone used for testing sideways too (either way up).
             Android 16 ignores it on tablets and large screens only, which is fine here. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LAUNCHER = show the app in a phone's app drawer (for testing). -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- LEANBACK_LAUNCHER = show the app on the Android TV home screen.
                     Without it the app installs on a TV but has no tile to open it. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
